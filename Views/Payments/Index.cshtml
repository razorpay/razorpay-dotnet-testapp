@model List<RazorpaySampleApp.Models.PaymentItem>
@using RazorpaySampleApp.Models

@{
    ViewData["Title"] = "Payments";
}

<h1>Payments  </h1> 
@if (ViewBag.Error != null)
{
    <div class="alert alert-error">
        <strong>Could not load payments.</strong> @ViewBag.Error
    </div>
}

@if (TempData["RefundSuccess"] != null)
{
    <div class="alert alert-success">@TempData["RefundSuccess"]</div>
}

@if (TempData["RefundError"] != null)
{
    <div class="alert alert-error">@TempData["RefundError"]</div>
}

@if (Model.Count == 0 && ViewBag.Error == null)
{
    <p>No payments found.</p>
}

@if (Model.Count > 0)
{
    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Amount</th>
                <th>Status</th>
                <th>Method</th>
                <th>Email</th>
                <th>Contact</th>
                <th>Refunded</th>
                <th>Created</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (PaymentItem item in Model)
            {
                <tr>
                    <td>@item.Id</td>
                    <td>@item.Currency @item.AmountInRupees.ToString("0.00")</td>
                    <td>@item.Status</td>
                    <td>@item.Method</td>
                    <td>@item.Email</td>
                    <td>@item.Contact</td>
                    <td>@item.AmountRefundedInRupees.ToString("0.00")</td>
                    <td>
                        @if (item.CreatedAt > 0)
                        {
                            @DateTimeOffset.FromUnixTimeSeconds(item.CreatedAt).ToLocalTime().ToString("yyyy-MM-dd HH:mm")
                        }
                    </td>
                    <td>
                        @if (item.CanRefund)
                        {
                            <form asp-action="Refund" asp-controller="Payments" method="post" class="refund-form">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="PaymentId" value="@item.Id" />
                                <input type="number" name="Amount" value="@item.Amount" min="1" max="@item.Amount" class="refund-amount" />
                                <button type="submit" class="btn btn-small">Refund</button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}